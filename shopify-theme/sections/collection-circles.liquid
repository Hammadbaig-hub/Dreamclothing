{{ 'section-collection-circles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'dot-particles.js' | asset_url }}" defer="defer"></script>

<div class="color-{{ section.settings.color_scheme }} gradient collection-circles-wrapper">
  <canvas
    class="collection-circles-canvas"
    data-dot-particles
    data-particle-color="120, 105, 90"
    data-max-alpha="0.4"
    aria-hidden="true"
  ></canvas>
  <div class="page-width section-{{ section.id }}-padding isolate collection-circles-content">
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin">
        <h2 class="collection-circles__title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endunless -%}

    <ul class="collection-circles-list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign circle_collection = block.settings.collection
          assign circle_image = block.settings.image
          if circle_image == blank and circle_collection != blank
            assign circle_image = circle_collection.featured_image
          endif
          assign circle_label = block.settings.label
          if circle_label == blank and circle_collection != blank
            assign circle_label = circle_collection.title
          endif
          assign circle_url = circle_collection.url | default: block.settings.link
        -%}
        <li class="collection-circle-item" {{ block.shopify_attributes }}>
          <a
            href="{{ circle_url | default: '#' }}"
            class="collection-circle"
            {% if circle_url == blank %}
              role="link" aria-disabled="true"
            {% endif %}
          >
            <span class="collection-circle__image">
              {%- if circle_image != blank -%}
                <img
                  src="{{ circle_image | image_url: width: 440 }}"
                  srcset="{{ circle_image | image_url: width: 220 }} 220w, {{ circle_image | image_url: width: 440 }} 440w"
                  sizes="220px"
                  alt="{{ circle_image.alt | default: circle_label | escape }}"
                  width="220"
                  height="220"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'collection-apparel-1' | placeholder_svg_tag }}
              {%- endif -%}
            </span>
            <span class="collection-circle__label">{{ circle_label | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{%- style -%}
  .collection-circles-wrapper {
    position: relative;
  }

  .collection-circles-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .collection-circles-content {
    position: relative;
    z-index: 1;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Collection circles",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Our Collections",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "circle",
      "name": "Collection circle",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image (optional)",
          "info": "Overrides the collection's featured image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Custom label (optional)",
          "info": "Overrides the collection title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link (optional)",
          "info": "Used only if no collection is selected"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection circles",
      "blocks": [
        { "type": "circle" },
        { "type": "circle" },
        { "type": "circle" }
      ]
    }
  ]
}
{% endschema %}
